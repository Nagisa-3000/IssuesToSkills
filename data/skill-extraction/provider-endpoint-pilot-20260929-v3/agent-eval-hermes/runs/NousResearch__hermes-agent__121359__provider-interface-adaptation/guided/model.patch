diff --git a/hermes_cli/models.py b/hermes_cli/models.py
index 74c4189f..89193cae 100644
--- a/hermes_cli/models.py
+++ b/hermes_cli/models.py
@@ -817,6 +817,20 @@ def _get_model_config_dict() -> dict[str, Any]:
     return {}
 
 
+def _configured_relay_base_url(provider: str) -> str:
+    """Return this provider's configured ``model.base_url``, never another provider's.
+
+    A configured relay is an explicit routing boundary: catalog discovery must use it and
+    must not retry against the provider's canonical host if the relay is unavailable.
+    """
+    model_cfg = _get_model_config_dict()
+    configured_provider = normalize_provider(model_cfg.get("provider"))
+    requested_provider = normalize_provider(provider)
+    if configured_provider != requested_provider:
+        return ""
+    return str(model_cfg.get("base_url") or "").strip().rstrip("/")
+
+
 def _base_url_looks_like_anthropic_messages(base_url: str) -> bool:
     normalized = str(base_url or "").strip().lower().rstrip("/")
     if not normalized:
@@ -1610,6 +1624,25 @@ def provider_model_ids(provider: Optional[str], *, force_refresh: bool = False)
         return _ollama_local_catalog(force_refresh)
 
     normalized = normalize_provider(provider)
+    relay_base_url = _configured_relay_base_url(normalized)
+    if relay_base_url:
+        profile = None
+        try:
+            from providers import get_provider_profile
+            profile = get_provider_profile(normalized)
+            api_key, _credential_base_url = _api_key_credentials(normalized)
+            live = profile.fetch_models(api_key=api_key, base_url=relay_base_url) if profile else None
+        except Exception:
+            live = None
+        if live:
+            return _chat_catalog_rows(list(live))
+        # The relay is terminal for live egress. Degrade to local data without touching any
+        # canonical fetcher or remote metadata source.
+        curated = list(_PROVIDER_MODELS.get(normalized, []))
+        if not curated and profile is not None:
+            curated = list(profile.fallback_models or ())
+        return _chat_catalog_rows(_drop_delisted_opencode_models(normalized, curated))
+
     fetcher = _PROVIDER_CATALOG_FETCHERS.get(normalized)
     if fetcher is not None:
         models = fetcher(normalized, force_refresh)
