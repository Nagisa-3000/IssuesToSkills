@@ -71,6 +81,30 @@ class Model:
         return self.name
 
 
+class OpenRouterModel(Model):
+    def __init__(self, name):
+        # Aider's editing behavior is based on the underlying OpenAI model,
+        # while OpenRouter exposes that model under a provider-qualified id.
+        model_name = name.rsplit("/", 1)[-1]
+        super().__init__(model_name)
+
+        import openai
+
+        models = openai.Model.list()
+        for model in models.data:
+            model_id = model["id"]
+            if model_id != name and model_id.rsplit("/", 1)[-1] != name:
+                continue
+
+            self.name = model_id
+            self.max_context_tokens = int(model["context_length"])
+            self.prompt_price = float(Decimal(model["pricing"]["prompt"]) * 1000)
+            self.completion_price = float(Decimal(model["pricing"]["completion"]) * 1000)
+            return
+
+        raise ValueError(f"Unknown OpenRouter model: {name}")
+
+
 GPT4 = Model("gpt-4")
 GPT35 = Model("gpt-3.5-turbo")
 GPT35_16k = Model("gpt-3.5-turbo-16k")
