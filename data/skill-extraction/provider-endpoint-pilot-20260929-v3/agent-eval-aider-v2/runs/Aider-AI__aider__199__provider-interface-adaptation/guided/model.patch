index fdbb2d1..1ae13e9 100644
--- a/aider/models.py
+++ b/aider/models.py
@@ -1,4 +1,8 @@
 import re
+from decimal import Decimal
+from urllib.parse import urlparse
+
+import openai
 
 known_tokens = {
     "gpt-3.5-turbo": 4,
@@ -14,6 +18,15 @@ class Model:
     prompt_price = None
     completion_price = None
 
+    @classmethod
+    def create(cls, name):
+        """Create the model implementation appropriate for the configured API."""
+        api_base = getattr(openai, "api_base", "") or ""
+        if urlparse(api_base).hostname == "openrouter.ai":
+            return OpenRouterModel(name)
+
+        return cls(name)
+
     def __init__(self, name):
         self.name = name
 
@@ -71,6 +84,33 @@ class Model:
         return self.name
 
 
+class OpenRouterModel(Model):
+    def __init__(self, name):
+        model_list = openai.Model.list().data
+
+        model = next(
+            (
+                item
+                for item in model_list
+                if item["id"] == name or item["id"].endswith("/" + name)
+            ),
+            None,
+        )
+        if model is None:
+            raise ValueError(f"Unknown OpenRouter model: {name}")
+
+        # Initialize aider's behavioral defaults from the OpenAI-compatible
+        # portion of the name, then replace its metadata with OpenRouter's.
+        base_name = model["id"].rsplit("/", 1)[-1]
+        super().__init__(base_name)
+
+        self.name = model["id"]
+        self.tokenizer_name = base_name
+        self.max_context_tokens = int(model["context_length"])
+        self.prompt_price = float(Decimal(model["pricing"]["prompt"]) * 1000)
+        self.completion_price = float(Decimal(model["pricing"]["completion"]) * 1000)
+
+
 GPT4 = Model("gpt-4")
 GPT35 = Model("gpt-3.5-turbo")
 GPT35_16k = Model("gpt-3.5-turbo-16k")
