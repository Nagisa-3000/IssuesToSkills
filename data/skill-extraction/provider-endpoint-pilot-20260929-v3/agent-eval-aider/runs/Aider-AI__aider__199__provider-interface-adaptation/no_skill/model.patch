@@ -71,6 +81,30 @@ class Model:
         return self.name
 
 
+class OpenRouterModel(Model):
+    def __init__(self, name):
+        import openai
+
+        # Initialize the editing behavior from the OpenAI-compatible model name.
+        # OpenRouter's catalog will supply the provider-qualified name and limits.
+        super().__init__(name.split("/", 1)[-1])
+
+        models = openai.Model.list().data
+        matches = [
+            model
+            for model in models
+            if model["id"] == name or model["id"].endswith("/" + name)
+        ]
+        if not matches:
+            raise ValueError(f"Unknown OpenRouter model: {name}")
+
+        model = matches[0]
+        self.name = model["id"]
+        self.max_context_tokens = int(model["context_length"])
+        self.prompt_price = float(Decimal(model["pricing"]["prompt"]) * 1000)
+        self.completion_price = float(Decimal(model["pricing"]["completion"]) * 1000)
+
+
