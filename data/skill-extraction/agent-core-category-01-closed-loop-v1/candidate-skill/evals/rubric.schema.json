{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_role_coverage": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "activation_decision": {
      "enum": [
        "activate",
        "clarify",
        "do_not_activate"
      ],
      "type": "string"
    },
    "anti_goal_violations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "interface_contract_quality": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "leakage_detected": {
      "type": "boolean"
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "unrelated_changes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "validation_quality": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "activation_decision",
    "interface_contract_quality",
    "action_role_coverage",
    "anti_goal_violations",
    "validation_quality",
    "unrelated_changes",
    "leakage_detected",
    "rationale"
  ],
  "title": "Resolution Skill activation and use rubric",
  "type": "object"
}
