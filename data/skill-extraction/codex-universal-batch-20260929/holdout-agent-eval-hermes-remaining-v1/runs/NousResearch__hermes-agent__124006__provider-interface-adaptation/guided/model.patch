+def _is_kimi_k3_model(model: str | None) -> bool:
+    """Return whether *model* uses Kimi K3's reasoning vocabulary.
+
+    Kimi's older models expose ``low|medium|high`` while K3 accepts only
+    ``low|high|max``.  Model names can be bare or prefixed by an aggregator,
+    so inspect the final path component and cover both the public
+    ``kimi-k3`` aliases and Kimi Coding's bare ``k3`` slug.
+    """
+    model_tail = (model or "").strip().lower().rsplit("/", 1)[-1]
+    return (
+        model_tail.startswith(("kimi-k3", "kimi_k3"))
+        or model_tail == "k3"
+        or model_tail.startswith(("k3.", "k3-"))
+    )
+
+
+def _kimi_reasoning_effort(model: str | None, reasoning_config: dict | None) -> str:
+    """Translate Hermes' effort ladder to the selected Kimi model's wire set.
+
+    K3 accepts ``low|high|max`` and defaults to ``high``.  K2-era models
+    accept ``low|medium|high``; retain their historical default of ``medium``
+    while mapping Hermes' lower and stronger aliases to the nearest supported
+    levels.  Returning a supported value for every input avoids Kimi's strict
+    request validation turning a ladder alias into an HTTP 400.
+    """
+    is_k3 = _is_kimi_k3_model(model)
+    if is_k3:
+        default = "high"
+        effort_map = {
+            "minimal": "low",
+            "low": "low",
+            "medium": "high",
+            "high": "high",
+            "xhigh": "max",
+            "max": "max",
+            "ultra": "max",
+        }
+    else:
+        default = "medium"
+        effort_map = {
+            "minimal": "low",
+            "low": "low",
+            "medium": "medium",
+            "high": "high",
+            "xhigh": "high",
+            "max": "high",
+            "ultra": "high",
+        }
+
+    if isinstance(reasoning_config, dict):
+        effort = str(reasoning_config.get("effort") or "").strip().lower()
+        return effort_map.get(effort, default)
+    return default
+
