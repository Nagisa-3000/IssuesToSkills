+
+    expect(switchModel).toHaveBeenCalledWith(
+      AuthType.USE_OPENAI,
+      'legacy-turn-model',
+      undefined,
+    );
+  });
+
+  it('prefers the session_model record over lastAssistantModel', async () => {
+    const switchModel = vi.fn().mockResolvedValue(undefined);
