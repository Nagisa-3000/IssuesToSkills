+      }),
+      getContentGeneratorConfig: vi.fn().mockReturnValue(undefined),
+      switchModel,
+    } as unknown as Config;
+
+    await applyRestoredSessionModel(
+      config,
+      recordingProjection({
+        lastCompletedUuid: 'leaf',
+        turnParentUuids: [null],
+        lastAssistantModel: 'legacy-turn-model',
