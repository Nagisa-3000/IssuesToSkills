+      undefined,
+    );
+  });
+
+  it('does not switch when the live config already matches', async () => {
+    const switchModel = vi.fn().mockResolvedValue(undefined);
+    const config = {
+      getModel: vi.fn().mockReturnValue('qwen3-coder-plus'),
