+def sync_plugin_provider_catalog() -> int:
+    """Admit provider profiles registered after this catalog was imported.
+
+    ``CANONICAL_PROVIDERS`` is intentionally a process-local snapshot used by several picker
+    surfaces. Provider discovery is lazy, however, and a plugin can register after this module has
+    been imported (including while another plugin is importing ``hermes_cli.models``). Keep the
+    snapshot live without rebuilding it: append each previously unseen slug exactly once and update
+    the labels map in place so modules that imported the dict by reference see the same change.
+
+    The provider registry owns discovery and may call this function while it is finishing a scan;
+    failures are therefore allowed to propagate to that caller, which treats derived-registry
+    refreshes as best-effort. The return value is the number of newly admitted provider rows.
+    """
+    from providers import list_providers
+
+    added = 0
+    for profile in list_providers():
+        slug = str(getattr(profile, "name", "") or "").strip()
+        if not slug or slug in _canonical_slugs:
+            continue
+        label = str(getattr(profile, "display_name", "") or slug)
+        description = str(getattr(profile, "description", "") or f"{label} (direct API)")
+        CANONICAL_PROVIDERS.append(ProviderEntry(slug, label, description))
+        _canonical_slugs.add(slug)
+        # During this module's first import the initial discovery loop runs below the function
+        # definition but before the labels dict is constructed. The canonical row is still safe to
+        # admit there; the final dict construction picks it up.
+        provider_labels = globals().get("_PROVIDER_LABELS")
+        if isinstance(provider_labels, dict):
+            provider_labels[slug] = label
+        added += 1
+
+        # ``hermes_cli.models`` keeps a set for the provider:model parser. It is normally created
+        # after this catalog, but when a plugin imports the parser during discovery it may already
+        # exist; mutate it in place for that late-registration case too.
+        models_module = sys.modules.get("hermes_cli.models")
+        known_names = getattr(models_module, "_KNOWN_PROVIDER_NAMES", None)
+        if isinstance(known_names, set):
+            known_names.add(slug)
+    return added
+
+
 try:
     from providers import list_providers as _list_providers_for_canonical
     for _pp in _list_providers_for_canonical():
