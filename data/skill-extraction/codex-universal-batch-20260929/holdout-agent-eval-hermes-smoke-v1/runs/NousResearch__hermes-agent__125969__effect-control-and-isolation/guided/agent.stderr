  27: def _profile_user_agent() -> str:
  28:     """Return a ``hermes-cli/<version>`` UA string, with a stable fallback.
  29: 
  30:     Used by ``ProviderProfile.fetch_models`` so the catalog probe is not
  31:     served the default ``Python-urllib/<ver>`` UA — some providers
  32:     (OpenCode Zen, etc.) sit behind a WAF that returns 403 for that.
  33:     """
  34:     try:
  35:         from hermes_cli import __version__ as _ver  # lazy: avoid layer cycle at import time
  36:         return f"hermes-cli/{_ver}"
  37:     except Exception:
  38:         return "hermes-cli"
  39: 
  40: 
  41: @dataclass
  42: class ProviderProfile:
  43:     """Base provider profile — subclass or instantiate with overrides."""
  44: 
  45:     # ── Identity ─────────────────────────────────────────────
  46:     name: str
  47:     api_mode: str = "chat_completions"
  48:     aliases: tuple = ()
  49: 
  50:     # ── Human-readable metadata ───────────────────────────────
  51:     display_name: str = ""       # e.g. "GMI Cloud" — shown in picker/labels
  52:     description: str = ""        # e.g. "GMI Cloud (multi-model direct API)" — picker subtitle
  53:     signup_url: str = ""         # e.g. "https://www.gmicloud.ai/" — shown during setup
  54: 
  55:     # ── Auth & endpoints ─────────────────────────────────────
  56:     env_vars: tuple = ()
  57:     base_url: str = ""
  58:     models_url: str = ""  # explicit models endpoint; falls back to {base_url}/models
  59:     auth_type: str = "api_key"   # api_key|oauth_device_code|oauth_external|copilot|aws_sdk
  60:     supports_health_check: bool = True  # False → doctor skips /models probe for this provider
  61:     # False → fetch_models returns None without a network call (catalog comes from an SDK/subprocess).
  62:     supports_model_listing: bool = True
  63: 
  64:     # ── Provider-owned auth (optional; non-api-key plugins) ──────────
  65:     # ``auth_handler(action, args) -> bool``: ``hermes auth add|status|logout|refresh <name>`` calls it
  66:     # FIRST with the parsed CLI namespace; truthy = the plugin owned the action, falsy = built-in path.
  67:     # ``refresh_credential(entry) -> Mapping | None``: the credential pool's refresh of a pooled OAuth
  68:     # row — return the rotated fields (``access_token``, ``refresh_token``, ``expires_at_ms`` …) or raise.
  69:     # Both own their own token endpoints; Hermes passes no secrets beyond the pooled row itself.
  70:     # ``classify_api_error(error, *, status_code, error_code, message, body, model) -> Mapping | None``:
  71:     # consulted by ``agent.error_classifier.classify_api_error`` for THIS provider's failures only, after
  72:     # the generic ``transform_api_error_classification`` plugin hooks and before the built-in pipeline.
  73:     # Return ``{"reason": <FailoverReason name>, ...hint flags}`` to override, ``None`` to decline.
  74:     auth_handler: Callable[[str, Any], Any] | None = None
  75:     refresh_credential: Callable[[Any], Any] | None = None
  76:     classify_api_error: Callable[..., Any] | None = None
  77: 
  78:     # ── Vision support ────────────────────────────────────────
  79:     # True when the provider's API accepts image content inside
  80:     # tool-result messages natively.  Set on providers that expose
  81:     # multimodal models via tool results (Anthropic Messages API,
  82:     # OpenAI Chat Completions, Gemini, MiniMax, etc.).
  83:     # Falls back to model-catalog lookup when False and the provider
  84:     # has no registered profile.
  85:     supports_vision: bool = False
  86: 
  87:     # True when the provider's API accepts list-type tool message
  88:     # content (multipart with image_url parts).  Defaults to True for
  89:     # backward compatibility.  Set to False for providers that accept
  90:     # multimodal user messages but reject list-type tool content
  91:     # (e.g. Xiaomi MiMo, which returns 400 "text is not set").
  92:     supports_vision_tool_messages: bool = True
  93: 
  94:     # True only when this provider's Chat Completions endpoint explicitly
  95:     # documents ``prompt_cache_key`` as an accepted request body field.  This
  96:     # is deliberately opt-in: many OpenAI-compatible endpoints reject unknown
  97:     # top-level fields rather than ignoring them.
  98:     supports_prompt_cache_key: bool = False
  99: 
 100:     # Private replay carriers use a namespaced '<provider>.native_assistant' type
 101:     # in reasoning_details. Only this profile may receive its matching carrier;
 102:     # other providers (including an unregistered fallback) get ordinary details only.
 103:     native_reasoning_details_type: str | None = None
 104: 
 105:     # ── External-process providers (auth_type="external_process") ──
 106:     # An agent CLI driven over stdio (ACP) rather than an HTTP endpoint. These
 107:     # describe how to launch it; hermes_cli/auth.py's
 108:     # resolve_external_process_provider_credentials() reads them instead of
 109:     # hardcoding one vendor's binary. Env vars are checked in order and win
 110:     # over the static defaults, so an operator can point at a custom build.
 111:     process_command: str = ""            # default binary, e.g. "copilot"
 112:     process_args: tuple = ()             # default argv tail, e.g. ("--acp", "--stdio")
 113:     process_command_env_vars: tuple = ()  # env overrides for the binary, in priority order
 114:     process_args_env_var: str = ""       # env override for argv (shlex-split)
 115: 
 116:     # ── Model catalog ─────────────────────────────────────────
 117:     # fallback_models: curated list shown in /model picker when live fetch fails.
 118:     # Only agentic models that support tool calling should appear here.
 119:     fallback_models: tuple = ()
 120:     # model_aliases: short name -> id in fallback_models, for providers whose catalog is not
 121:     # in models.dev (external processes); `/model <alias>` resolves here before core guessing.
 122:     model_aliases: dict = field(default_factory=dict)
 123: 
 124:     # hostname: base hostname for URL→provider reverse-mapping in model_metadata.py
 125:     # e.g. "api.gmi-serving.com". Derived from base_url when empty.
 126:     hostname: str = ""
 127: 
 128:     # ── Client-level quirks (set once at client construction) ─
 129:     default_headers: dict[str, str] = field(default_factory=dict)
 130: 
 131:     # ── Request-level quirks ─────────────────────────────────
 132:     # Temperature: None = use caller's default, OMIT_TEMPERATURE = don't send
 133:     fixed_temperature: Any = None
 134:     default_max_tokens: int | None = None
 135:     # ``response_format`` types the API rejects outright (e.g. ("json_schema",)); aux requests omit them up front.
 136:     unsupported_response_formats: tuple = ()
 137:     default_aux_model: str = (
 138:         ""  # cheap model for auxiliary tasks (compression, vision, etc.)
 139:     )
 140:     # empty = use main model
 141: 
 142:     # Per-model metadata in the canonical model_overrides schema. Partial entries
 143:     # patch catalog metadata; explicit user overrides still win. Exact model IDs.
 144:     model_capabilities: dict[str, dict[str, Any]] = field(default_factory=dict)
 145: 
 146:     # ── Hooks (override in subclass for complex providers) ───
 147: 
 148:     def fetch_account_usage(
 149:         self, *, base_url: str | None = None, api_key: str | None = None
 150:     ) -> AccountUsageSnapshot | None:
 151:         """Return an account-usage snapshot for this provider, if available.
 152: 
 153:         The ``/usage`` command invokes this only when no built-in account
 154:         usage fetcher owns the provider. Implementations may make their
 155:         provider-specific request and must return an ``AccountUsageSnapshot``
 156:         or ``None``; exceptions fail open at the dispatch boundary.
 157:         """
 158:         return None
 159: 
 160:     def resolve_aux_model(self, *, vision: bool = False) -> str:
 161:         """Return a LIVE cheap-model id for auxiliary tasks, or "".
 162: 
 163:         ``default_aux_model`` is a hardcoded id in source, so it rots: when the
 164:         provider retires that model every auxiliary call spends a round-trip
 165:         404ing before the retry net catches it. Providers that publish a
 166:         machine-readable recommendation should override this and query it, so
 167:         the cheap tier tracks the upstream catalog instead of a constant a human
 168:         has to remember to bump.
 169: 
 170:         Contract: cheap to call (implementations must cache — this runs on
 171:         client-resolution paths), never raises, and returns "" when it has no
 172:         answer so the caller falls through to ``default_aux_model``.
 173:         """
 174:         return ""
 175: 
 176:     def get_hostname(self) -> str:
 177:         """Return the provider's base hostname for URL-based detection.
 178: 
 179:         Uses self.hostname if set explicitly, otherwise derives it from base_url.
 180:         e.g. 'https://api.gmi-serving.com/v1' → 'api.gmi-serving.com'
