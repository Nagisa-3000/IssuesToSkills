 169:     "profiles.list", "profiles.set_asset", "bot_relay.roster.sync", "bot_relay.outbox.drain",
 170:     "bot_relay.deliver", "bot_relay.reply", "image.generate", "projects.discover_repos",
 171:     "projects.record_repos", "projects.for_cwd", "projects.tree", "projects.project_sessions",
 172:     "setup.runtime_check", "setup.status", "free_tier.provision", "voice.toggle", "voice.record", "voice.tts", "wake.start",
 173:     "wake.status", "session.active_list", "session.branch", "session.compress", "session.list",
 174:     "session.resume", "session.workspace.move", "shell.exec", "skills.manage", "slash.exec",
 175:     "command.dispatch",  # /goal draft invokes the auxiliary model; never block the RPC reader
 176: })
 177: 
 178: _rpc_pool_workers = max(2, env_int("HERMES_TUI_RPC_POOL_WORKERS", 8))
 179: _pool = concurrent.futures.ThreadPoolExecutor(max_workers=_rpc_pool_workers, thread_name_prefix="tui-rpc")
 180: atexit.register(lambda: _pool.shutdown(wait=False, cancel_futures=True))
 181: 
 182: # Exact in-memory session record executing on the current turn thread — unlike a public session id,
 183: # this object identity cannot be supplied by RPC.
 184: _current_runtime_session_record: contextvars.ContextVar[dict | None] = contextvars.ContextVar(
 185:     "hermes_gateway_runtime_session_record", default=None)
 186: # JSON-RPC method being dispatched on this thread/task. Diagnostic only (names WHICH client
 187: # poll is looping in the 4001 warning); never authorization — the method string is client-supplied.
 188: _current_rpc_method: contextvars.ContextVar[str] = contextvars.ContextVar("hermes_gateway_rpc_method", default="")
 189: 
 190: # Reserve real stdout for JSON-RPC only; redirect Python's stdout to stderr so stray print() from
 191: # libraries/tools becomes harmless gateway.stderr instead of corrupting the JSON protocol.
 192: _real_stdout = sys.stdout
 193: sys.stdout = sys.stderr
 194: 
 195: 
 196: class _DropTransport:
 197:     """Detached WS sink: keep sessions resumable without writing stale frames."""
 198: 
 199:     def write(self, obj: dict) -> bool:
 200:         return False
 201: 
 202:     def close(self) -> None:
 203:         pass
 204: 
 205: 
 206: # Module-level stdio transport — fallback sink when no transport is bound via contextvar or session.
 207: # Stream resolved through a lambda so test monkey-patches of `_real_stdout` still land.
 208: _stdio_transport = StdioTransport(lambda: _real_stdout, _stdout_lock)
 209: 
 210: # Detached websocket sessions use a drop sink instead of stdio: Desktop embeds the gateway in-process
 211: # and captures stdout into logs, so stale frames must not fall through while a session awaits resume/reap.
 212: _detached_ws_transport = _DropTransport()
 213: 
 214: 
 215: def _prepend_tool_paths(env: dict[str, str]) -> dict[str, str]:
 216:     """Prepend managed bin (first: managed-first policy for the Browser Use CLI), venv bin and
 217:     ~/.local/bin to PATH so slash_worker children resolve Hermes-managed CLIs under the Desktop's minimal PATH."""
 218:     managed_bin = ""
 219:     with contextlib.suppress(Exception):
 220:         managed_bin = str(Path(get_hermes_home()) / "bin")
 221:     venv_bin = str(Path(sys.executable).parent)  # <venv>/bin (POSIX) or <venv>/Scripts (Windows)
 222:     parts = [p for p in (managed_bin, venv_bin, str(Path.home() / ".local" / "bin"), env.get("PATH") or "") if p]
 223:     env["PATH"] = os.pathsep.join(parts)
 224:     return env
 225: 
 226: 
 227: class _SlashWorker:
 228:     """Persistent HermesCLI subprocess for slash commands."""
 229: 
 230:     def __init__(self, session_key: str, model: str, profile_home: str | None = None):
 231:         self._lock = threading.Lock()
 232:         self._seq = 0
 233:         self.stderr_tail: list[str] = []
 234:         self.stdout_queue: queue.Queue[dict | None] = queue.Queue()
 235:         argv = [sys.executable, "-m", "tui_gateway.slash_worker", "--session-key", session_key] + (["--model", model] if model else [])
 236:         self._closed = False
 237:         from hermes_cli._subprocess_compat import windows_hide_flags
 238:         # slash_worker runs the Hermes agent → needs provider credentials. Tier-1 secrets
 239:         # (gateway/GitHub/infra) are still stripped (#29157). Global-remote / multi-profile sessions: the
 240:         # worker must resolve config/skills/state against the session's profile home, not the gateway's
 241:         # launch HERMES_HOME (#40677).
 242:         from tools.environments.local import served_profile_child_env
 243:         from agent.secret_scope import is_multiplex_active
 244: 
 245:         # The worker runs the agent → needs provider credentials; tier-1 secrets (gateway/GitHub/
 246:         # infra) are still stripped. A served profile's worker gets THAT profile's home + secrets and
 247:         # none of the launch profile's .env / TERMINAL_* residue, exactly what a standalone
 248:         # `hermes -p X` would load itself. The launch profile is a profile too: once the process hosts
 249:         # a second home (multiplex flipped), its worker must name its own home or the fail-closed
 250:         # no-target/no-scope path raises UnscopedSecretError (#115427).
 251:         env = _prepend_tool_paths(served_profile_child_env(
 252:             target_home=profile_home or (_hermes_home if is_multiplex_active() else None),
 253:             inherit_credentials=True))
 254:         # Internal slash workers must import the same checkout as their parent.
 255:         module_root = str(Path(__file__).resolve().parent.parent)
 256:         env["PYTHONPATH"] = os.pathsep.join(
 257:             part for part in (module_root, env.get("PYTHONPATH", "")) if part
 258:         )
 259:         # start_new_session: otherwise the worker inherits the gateway's pgid and mcp_tool's orphan
 260:         # sweep, racing the spawn, killpg()s the TUI parent itself. errors="replace": bytes invalid
