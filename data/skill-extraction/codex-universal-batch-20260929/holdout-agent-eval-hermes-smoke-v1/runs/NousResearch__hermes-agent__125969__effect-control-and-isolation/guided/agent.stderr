 119: # When a WebSocket client (the dashboard's embedded-chat tab / desktop app) disconnects, ``tui_gateway.ws``
 120: # detaches the transport but intentionally leaves the session parked so a quick reconnect can reattach it
 121: # (see ws.py). That park is unbounded, though: a browser refresh spins up a brand-new ``session.create``
 122: # (new sid + a fresh _SlashWorker via _deferred_build) and never reattaches the OLD sid, so the old
 123: # session's slash-worker subprocess lingers forever — one leaked python process per refresh (#38591
 124: # fallout). After this grace window, an orphaned WS session is interrupted if it is still running, then
 125: # reaped once the normal turn-finalization path settles. Set to 0 to disable (park forever, pre-fix
 126: # behaviour).
 127: def _resolve_ws_orphan_reap_grace() -> float:
 128:     """Grace before an orphaned WS session is interrupted/reaped (0 = park forever): ws.py parks a
 129:     disconnected session for a quick reattach, but a browser refresh mints a NEW sid and never
 130:     reattaches the old one (leaking its slash worker)."""
 131:     return _ws_orphan_setting("HERMES_TUI_WS_ORPHAN_REAP_GRACE_S", "ws_orphan_reap_grace_s", 20.0)
 132: 
 133: 
 134: _WS_ORPHAN_REAP_GRACE_S = _resolve_ws_orphan_reap_grace()
