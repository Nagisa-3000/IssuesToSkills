+def sync_plugin_provider_catalog() -> int:
+    """Admit newly registered plugin providers into the picker catalog.
+
+    ``CANONICAL_PROVIDERS`` is intentionally a stable list object because ``hermes_cli.models``
+    imports it once and several picker surfaces share that reference.  Provider discovery can,
+    however, finish after this module has been imported (or a plugin can register at runtime).
+    Append only previously unseen slugs and update the label snapshot in the same operation so
+    those surfaces agree without requiring a process restart.
+    """
+    try:
+        from providers import list_providers
+        profiles = list_providers()
+    except Exception:
+        return 0
+
+    labels = globals().get("_PROVIDER_LABELS")
+    added = 0
+    for profile in profiles:
+        if not _plugin_provider_enters_picker(profile):
             continue
-        _label = _pp.display_name or _pp.name
-        CANONICAL_PROVIDERS.append(ProviderEntry(_pp.name, _label, _pp.description or f"{_label} (direct API)"))
-        _canonical_slugs.add(_pp.name)
+        label = profile.display_name or profile.name
+        CANONICAL_PROVIDERS.append(
+            ProviderEntry(profile.name, label, profile.description or f"{label} (direct API)")
+        )
+        _canonical_slugs.add(profile.name)
+        if isinstance(labels, dict):
+            labels[profile.name] = label
+        added += 1
+    return added
+
+
+try:
+    sync_plugin_provider_catalog()
 except Exception:
     pass
 
