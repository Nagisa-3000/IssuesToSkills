  "original_source_excerpt": "602: \n603: # Globally defined names which are not attributes of the builtins module, or\n604: # are only present on some platforms.\n605: _MAGIC_GLOBALS = ['__file__', '__builtins__', 'WindowsError']\n606: # module scope annotation will store in `__annotations__`, see also PEP 526.\n607: if PY36_PLUS:\n608:     _MAGIC_GLOBALS.append('__annotations__')\n609: \n610: \n611: def getNodeName(node):\n612:     # Returns node.id, or node.name, or None\n613:     if hasattr(node, 'id'):     # One of the many nodes with an id\n614:         return node.id\n615:     if hasattr(node, 'name'):   # an ExceptHandler node\n616:         return node.name\n617: \n618: \n619: def is_typing_overload(value, scope_stack):\n620:     def name_is_typing_overload(name):  # type: (str) -> bool\n621:         for scope in reversed(scope_stack):\n622:             if name in scope:\n623:                 return (\n624:                     isinstance(scope[name], ImportationFrom) and\n625:                     scope[name].fullName == 'typing.overload'\n626:                 )\n627: \n628:         return False\n629: \n630:     def is_typing_overload_decorator(node):\n631:         return (\n632:             (\n633:                 isinstance(node, ast.Name) and name_is_typing_overload(node.id)\n634:             ) or (\n635:                 isinstance(node, ast.Attribute) and\n636:                 isinstance(node.value, ast.Name) and\n637:                 node.value.id == 'typing' and\n638:                 node.attr == 'overload'\n639:             )\n640:         )\n641: \n642:     return (\n643:         isinstance(value.source, ast.FunctionDef) and\n644:         any(\n645:             is_typing_overload_decorator(dec)\n646:             for dec in value.source.decorator_list\n647:         )\n648:     )\n649: \n650: \n651: def make_tokens(code):\n652:     # PY3: tokenize.tokenize requires readline of bytes\n653:     if not isinstance(code, bytes):\n654:         code = code.encode('UTF-8')\n655:     lines = iter(code.splitlines(True))\n656:     # next(lines, b'') is to prevent an error in pypy3\n657:     return tuple(tokenize_tokenize(lambda: next(lines, b'')))\n658: \n659: \n660: class _TypeableVisitor(ast.NodeVisitor):\n661:     \"\"\"Collect the line number and nodes which are deemed typeable by\n662:     PEP 484",
