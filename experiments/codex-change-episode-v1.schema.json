{
  "type": "object",
  "additionalProperties": false,
  "required": ["episode", "evidence_units", "candidate_atomics", "candidate_workflows", "unresolved_questions"],
  "properties": {
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "title", "before", "after", "diff"],
      "properties": {
        "episode_id": {"type": "string"},
        "title": {"type": "string"},
        "before": {"type": "string"},
        "after": {"type": "string"},
        "diff": {"type": "string"}
      }
    },
    "evidence_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "claim", "source"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "claim": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "candidate_atomics": {
      "type": "array",
      "items": {
        "type": "object",
