        "required": ["name", "description", "evidence_ids"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "candidate_workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "atomic_names", "evidence_ids"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "atomic_names": {"type": "array", "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "unresolved_questions": {"type": "array", "items": {"type": "string"}}
