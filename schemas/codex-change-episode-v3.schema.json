{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Change Episode v3 with mandatory Skill compilation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode",
    "evidence_units",
    "candidate_atomics",
    "candidate_workflows",
    "unresolved_questions"
  ],
  "properties": {
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "title",
        "before",
        "after",
        "diff"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "diff": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "claim",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate_atomics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "description",
          "evidence_ids",
          "semantic_action"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "semantic_action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intent",
              "module_role",
              "operation",
              "pre_state",
              "post_state",
              "validation",
              "parameters",
              "evidence_ids"
            ],
            "properties": {
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "module_role": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "pre_state": {
                "type": "string",
                "minLength": 1
              },
              "post_state": {
                "type": "string",
                "minLength": 1
              },
              "validation": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "candidate_workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "description",
          "atomic_names",
          "evidence_ids",
          "workflow_graph",
          "skill_contract"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "atomic_names": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "workflow_graph": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goal",
              "when_to_use",
              "anti_goals",
              "not_applicable_when",
              "inputs",
              "entry_state",
              "exit_state",
              "steps",
              "edges",
              "validation_ladder",
              "stop_conditions",
              "unresolved_or_deferred"
            ],
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "when_to_use": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anti_goals": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "not_applicable_when": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "entry_state": {
                "type": "string",
                "minLength": 1
              },
              "exit_state": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action_name",
                    "role",
                    "required",
                    "depends_on",
                    "condition",
                    "validation"
                  ],
                  "properties": {
                    "action_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "diagnose",
                        "establish-contract",
                        "implement",
                        "reconcile",
                        "validate",
                        "repair"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "depends_on": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "condition": {
                      "type": "string"
                    },
                    "validation": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to",
                    "type"
                  ],
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "requires",
                        "enables",
                        "validates",
                        "repairs"
                      ]
                    }
                  }
                }
              },
              "validation_ladder": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stop_conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unresolved_or_deferred": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "skill_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "applicability_probes",
              "failure_modes",
              "known_limitations"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 63
              },
              "description": {
                "type": "string",
                "minLength": 20
              },
              "applicability_probes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "failure_modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "known_limitations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "https://arex.dev/schemas/codex-change-episode-v3.schema.json"
}
